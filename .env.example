# Example Environment Configuration
# Copy this to .env and fill in your actual values

# Supabase PostgreSQL (pooled connection for the running backend)
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase PostgreSQL (direct connection for Prisma migrations)
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Supabase API (publishable values may be exposed to the browser)
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Server-only; never expose these values to browser code
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_..."

# Credentials used only to create the first super administrator on initial login
SUPER_ADMIN_EMAIL="admin@example.com"
SUPER_ADMIN_PASSWORD="replace-with-a-strong-password"

# Keep the admin portal invite-only unless both values are explicitly enabled.
ALLOW_PUBLIC_SIGNUP=false
NEXT_PUBLIC_ALLOW_PUBLIC_SIGNUP=false

# Server Configuration
PORT=3001
NODE_ENV=development

# Application URL
APP_URL=http://localhost:8080

# Session Secret
SESSION_SECRET=replace-with-at-least-32-random-characters

# M-Pesa Configuration (optional)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=

# CORS Origins
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
